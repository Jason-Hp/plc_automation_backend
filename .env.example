# App
APP_NAME=PLC Automation API
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/plc_automation

# SMTP / Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=info@plcautomationgroup.com
ADMIN_EMAIL=sales@plcautomat.com
QUOTE_AND_ENQUIRY_EMAIL=quotes@plcautomat.com
HR_EMAIL=hr@plcautomat.com

# Local storage and logs
UPLOAD_DIR=./uploads
WEB_LOG_LOCATION=./logs/web_logs
WARN_LOG_LOCATION=./logs/warn_logs
ERROR_LOG_LOCATION=./logs/error_logs
ENQUIRY_LOG_LOCATION=./logs/enquiry_logs
ADMIN_LOG_LOCATION=./logs/admin_logs

# Semantic search & Supabase auth
# OPENAI_API_KEY is used for semantic search embeddings.
OPENAI_API_KEY=

# Supabase configuration for DB-backed repositories + auth.
# If left empty, the app will fall back to in-memory repositories (dev mode).
SUPABASE_URL=
SUPABASE_KEY=
# Optional: expected JWT audience (e.g. "authenticated")
SUPABASE_JWT_AUDIENCE=

# Admin / approver identity (must match Supabase user identifier, e.g. email)
ADMIN_USERNAME=admin

# Optional AWS S3 storage (leave empty to use local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BLOB_BUCKET=
AWS_S3_LOG_BUCKET=
AWS_REGION=us-east-1
AWS_CLOUDFRONT_DOMAIN=

# Operating Timezone
TIMEZONE=Asia/Singapore
