# App
APP_NAME=PLC Automation API
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000

# Database URL
DATABASE_URL=

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Gmail Account for sending emails (preferably use an email just for sending emails, not for receiving)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

ADMIN_EMAIL=
QUOTE_AND_ENQUIRY_EMAIL=
HR_EMAIL=

# Local logs
WEB_LOG_LOCATION=./app/logs/web_logs
ERROR_LOG_LOCATION=./app/logs/error_logs
ADMIN_LOG_LOCATION=./app/logs/admin_logs
DEBUG_LOG_LOCATION=./app/logs/debug_logs

# Semantic search & Supabase auth
# OPENAI_API_KEY is used for semantic search embeddings.
OPENAI_API_KEY=

# Supabase configuration (REQUIRED for DB-backed repositories + auth)
SUPABASE_URL=
SUPABASE_KEY=
# Optional: expected JWT audience (e.g. "authenticated")
SUPABASE_JWT_AUDIENCE=authenticated


# Optional AWS S3 storage (leave empty to use local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# This is the media assets bucket
AWS_S3_BLOB_BUCKET=
AWS_S3_LOG_BUCKET=
AWS_REGION=ap-southeast-1
AWS_CLOUDFRONT_DOMAIN=

# Operating Timezone
TIMEZONE=Asia/Singapore
